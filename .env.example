GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional extra Gemini accounts
GEMINI_API_KEY_A=
GEMINI_API_KEY_B=
GEMINI_API_KEY_C=

# Optional Claude creative-writing specialist.
# Claude API usage is billed by Anthropic; the free claude.ai chat plan is not an API key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Creative writing now uses OpenRouter's free-model pool first, then Gemini.
# Set to claude only if you explicitly want Claude to be preferred and have a key.
# auto = free OpenRouter first -> Gemini fallback -> optional Claude fallback
# claude = Claude first -> free OpenRouter -> Gemini
# existing = free OpenRouter first -> Gemini, never Claude
TOONSCRIPTURE_CREATIVE_PROVIDER=existing

# Optional free-model collaborator
OPENROUTER_API_KEY=
