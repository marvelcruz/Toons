GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional extra Gemini accounts
GEMINI_API_KEY_A=
GEMINI_API_KEY_B=
GEMINI_API_KEY_C=

# Optional Claude creative-writing specialist.
# Claude API usage is billed by Anthropic; the free claude.ai chat plan is not an API key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# auto = Claude for script/retention when connected, otherwise current Gemini + OpenRouter
# claude = prefer Claude but fall back if unavailable
# existing = never call Claude
TOONSCRIPTURE_CREATIVE_PROVIDER=auto

# Optional free-model collaborator
OPENROUTER_API_KEY=
